{
  "name": "poczy-hardware-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write \"src/**/*.{js,vue,css}\" \"*.{html,js,json}\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css}\" \"*.{html,js,json}\" \"tests/**/*.js\"",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "vue": "^3.5.44"
  }
}
