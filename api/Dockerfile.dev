# syntax=docker/dockerfile:1
FROM php:8.5-cli-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl git unzip libicu-dev libzip-dev \
    && docker-php-ext-install -j"$(nproc)" bcmath intl pcntl pdo_mysql zip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

ARG LOCAL_UID=1000
ARG LOCAL_GID=1000
RUN groupadd --gid "$LOCAL_GID" app \
    && useradd --uid "$LOCAL_UID" --gid app --create-home app \
    && mkdir -p /var/www/html \
    && chown app:app /var/www/html

WORKDIR /var/www/html
COPY --chown=app:app composer.json composer.lock ./
USER app
RUN composer install --no-interaction --prefer-dist --no-scripts
COPY --chown=app:app . .
COPY --chmod=755 <<'ENTRYPOINT_SCRIPT' /usr/local/bin/api-entrypoint
#!/bin/sh
set -eu

if [ ! -f .env ]; then
    cp .env.example .env
fi

composer install --no-interaction --prefer-dist
php artisan config:clear --no-interaction

if [ -z "${APP_KEY:-}" ] && ! grep -Eq '^APP_KEY=.+$' .env; then
    php artisan key:generate --no-interaction
fi

exec "$@"
ENTRYPOINT_SCRIPT

EXPOSE 8000
ENTRYPOINT ["api-entrypoint"]
CMD ["php", "artisan", "serve", "--no-reload", "--host=0.0.0.0", "--port=8000"]
